# Web admin portal: bind to Linux server LAN IPv4 (e.g. 192.168.1.50)
# to make it accessible from another machine on your private network.
# Defaults to loopback until you explicitly set the LAN address.
MCD_PORTAL_BIND_IP=127.0.0.1
# Do NOT forward TCP/8080 in your router or expose the portal on the internet.
MCD_TOKEN=replace-with-a-unique-32-byte-random-secret
MCD_HOST_DATA=/srv/minecraft-deployer/data
# One fixed port shared by every installed profile. Forward this single TCP port.
MCD_GAME_PORT=25565
# Public DNS name or IP for the Minecraft game (not the portal).
MCD_PUBLIC_HOST=minecraft.example.com
MCD_MAX_RAM_GB=12
CF_API_KEY=
